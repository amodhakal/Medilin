# Canonical variable list. src/lib/env.ts is the source of truth; this file and
# the README are written against it.
#
# Required: the server validates these at boot (src/instrumentation.ts) and
# refuses to start if any is missing.
# Optional: absent values disable the feature behind them.

# ── Required ───────────────────────────────────────────────────────────────

# LLM translation of intake responses. https://aistudio.google.com/apikey
GEMINI_KEY=

# Transactional email. https://resend.com/api-keys
RESEND_KEY=

# Key-encryption key for patient data at rest (AES-256-GCM envelope
# encryption). Exactly 32 bytes, hex-encoded — generate with:
#   openssl rand -hex 32
# There is no fallback. If this is unset, encryption throws rather than
# deriving a key from a value in the source tree.
HIPAA_MASTER_KEY=

# ElevenLabs Conversational AI agent identifiers, from the agent's share URL.
# Read server-side only. They are never sent to the browser: a browser that
# knows one can dial the vendor with it directly and spend the account's quota.
ELEVENLABS_AGENT_PATIENT_ID=
ELEVENLABS_AGENT_RECEPTIONIST_ID=

# Shared secret authenticating this app's internal calls to /api/webhook and
# /api/audit. At least 32 characters — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────

# ElevenLabs API key. Optional, and it gates the whole voice feature: the
# browser asks /api/voice/session for a short-lived signed conversation URL and
# this server signs it with this key, so the agent ids above never leave the
# server. It is also what voice-first intake (#61) needs to transcribe a
# recording and to read the details back; without it /voice offers the form
# instead. A server secret, and it must never reach the client.
# ELEVENLABS_API_KEY=

# Postgres for the durable appointment store and the durable audit log. Must be
# an http(s) Postgres HTTP endpoint — the connection string Neon and the other
# serverless Postgres providers issue — not a postgres:// socket URL.
#
# Unset is a supported configuration, and it is the default: appointments go to
# an in-memory store and the audit trail stays in the process. Both are
# per-instance and neither survives a serverless cold start, so a deployment
# that leaves this unset is still losing bookings, and has an audit trail with
# gaps in it that are indistinguishable from accesses nobody recorded. Setting it
# is all it takes to switch; nothing else needs configuring.
# DATABASE_URL=

# Which voice reads a patient's intake details back to them in voice intake.
# Optional: a stock default voice is used when this is absent.
# ELEVENLABS_TTS_VOICE_ID=

# Clinic identity shown to patients.
# CLINIC_NAME=City Medical Center

# Sender for confirmation email. Resend's free tier only delivers to the
# account owner's own address; a verified domain is required to reach
# patients. See the Resend section of the README.
# EMAIL_FROM=onboarding@resend.dev

# Error monitoring. Unset means off: src/lib/logger/sentry loads no SDK and
# sends nothing, so a contributor and CI run the app unchanged. What is sent is
# rebuilt from the logger's allowlist — see src/lib/logger/sentry-event.ts
# before you point this at a live project.
# SENTRY_DSN=

# Authenticates scheduled jobs hitting /api/cron/*.
# CRON_SECRET=

# Twilio messaging: SMS and WhatsApp appointment confirmations.
# Set all three or none — a partial set leaves the confirmation email-only.
# TWILIO_FROM_NUMBER is the sender in E.164, e.g. +15558675309. Prefix it with
# `whatsapp:` to send over Twilio's WhatsApp channel instead of SMS, e.g.
# whatsapp:+15558675309. Unset means no text confirmation is attempted.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Twilio voice: the outbound call to clinic reception when a booking is
# negotiated (#64). Reuses the three variables above — one account, one sender —
# and adds two. All five or none: a partial set disables dialling rather than
# half-configuring it, and an unset set is the default, so local development and
# CI behave exactly as they did before dialling existed.
#
# TWILIO_CLINIC_NUMBER is the line to ring, in E.164. There is no default and
# no per-request override: a number this application did not choose is a number
# it should not be dialling.
#
# TWILIO_CALLBACK_BASE_URL is the absolute https origin Twilio fetches this
# app's TwiML from. It cannot be derived from the request that triggered the
# call — that request's Host header is the client's to set, and Twilio is not
# the client. Everything after the origin (path, query, fragment) is ignored.
#
# ⚠ Before pointing this at a real clinic line, set a spend limit on the Twilio
# account. The in-process budget in src/lib/twilio/call-budget.ts is per-instance
# and in memory: it catches a loop on one instance, and it is not a quota on a
# serverless deployment. The console limit is the control that holds.
# TWILIO_CLINIC_NUMBER=
# TWILIO_CALLBACK_BASE_URL=

# HMAC-SHA256 secrets verifying inbound vendor callbacks on /api/webhook
# (#65). Optional: when a vendor's secret is unset, that vendor's signatures
# are not verified and the internal shared secret remains the only gate.
# TWILIO_WEBHOOK_SECRET=
# ELEVENLABS_WEBHOOK_SECRET=
