# Canonical variable list. src/lib/env.ts is the source of truth; this file and
# the README are written against it.
#
# Required: the server validates these at boot (src/instrumentation.ts) and
# refuses to start if any is missing.
# Optional: absent values disable the feature behind them.

# ── Required ───────────────────────────────────────────────────────────────

# LLM translation of intake responses. https://aistudio.google.com/apikey
GEMINI_KEY=

# Transactional email. https://resend.com/api-keys
RESEND_KEY=

# Key-encryption key for patient data at rest (AES-256-GCM envelope
# encryption). Exactly 32 bytes, hex-encoded — generate with:
#   openssl rand -hex 32
# There is no fallback. If this is unset, encryption throws rather than
# deriving a key from a value in the source tree.
HIPAA_MASTER_KEY=

# ElevenLabs Conversational AI agent identifiers, from the agent's share URL.
ELEVENLABS_AGENT_PATIENT_ID=
ELEVENLABS_AGENT_RECEPTIONIST_ID=

# Shared secret authenticating this app's internal calls to /api/webhook and
# /api/audit. At least 32 characters — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Optional ───────────────────────────────────────────────────────────────

# ElevenLabs API key. Unused while the browser opens conversation sockets
# directly; required once sessions are proxied server-side.
# ELEVENLABS_API_KEY=

# Postgres for the durable appointment store and the durable audit log. Must be
# an http(s) Postgres HTTP endpoint — the connection string Neon and the other
# serverless Postgres providers issue — not a postgres:// socket URL.
#
# Unset is a supported configuration, and it is the default: appointments go to
# an in-memory store and the audit trail stays in the process. Both are
# per-instance and neither survives a serverless cold start, so a deployment
# that leaves this unset is still losing bookings, and has an audit trail with
# gaps in it that are indistinguishable from accesses nobody recorded. Setting it
# is all it takes to switch; nothing else needs configuring.
# DATABASE_URL=

# Clinic identity shown to patients.
# CLINIC_NAME=City Medical Center

# Sender for confirmation email. Resend's free tier only delivers to the
# account owner's own address; a verified domain is required to reach
# patients. See the Resend section of the README.
# EMAIL_FROM=onboarding@resend.dev

# Error reporting.
# SENTRY_DSN=

# Authenticates scheduled jobs hitting /api/cron/*.
# CRON_SECRET=

# Twilio Programmable Voice, for outbound clinic calls and SMS.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
